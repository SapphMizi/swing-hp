      "html": "<a href=\"#\" class=\"ds-news\"><time class=\"ds-sticky\"><span class=\"ds-y\">2026</span><span class=\"ds-md\">4.2</span></time><span class=\"ds-news-t\">4月の新歓ライブの日程を公開しました</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a>",
