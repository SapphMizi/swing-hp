      "html": "<a href=\"#\" class=\"ds-btn ds-btn-secondary\"><span>スケジュール</span><span class=\"ds-dot\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></span></a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:16px;min-height:48px;padding:8px 8px 8px 24px;border:2px solid;border-radius:9999px;font-family:'Zen Maru Gothic',sans-serif;font-weight:700;text-decoration:none;transition:background-color 150ms,border-color 150ms;} .ds-btn .ds-dot{display:flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:9999px;transition:transform 150ms;} .ds-btn:hover .ds-dot{transform:translateX(2px);} .ds-btn-secondary{background:var(--color-paper-light,#fdeee1);border-color:var(--color-ink,#2b1d1f);color:var(--color-ink,#2b1d1f);} .ds-btn-secondary .ds-dot{background:var(--color-ink,#2b1d1f);color:var(--color-paper-light,#fdeee1);} .ds-btn-secondary:hover{background:var(--color-yellow,#fbd96e);} .ds-btn-secondary:focus-visible{outline:3px solid var(--color-ink,#2b1d1f);outline-offset:2px;box-shadow:0 0 0 5px var(--color-yellow,#fbd96e);}"
