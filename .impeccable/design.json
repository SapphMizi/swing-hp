      "html": "<nav><ul class=\"ds-keys\"><li><a href=\"#\" class=\"ds-key\" aria-current=\"page\"><b lang=\"en\">About</b><small>部について</small></a><span class=\"ds-black\"></span></li><li><a href=\"#\" class=\"ds-key\"><b lang=\"en\">News</b><small>お知らせ</small></a><span class=\"ds-black\"></span></li><li><a href=\"#\" class=\"ds-key\"><b lang=\"en\">Live</b><small>ライブレポート</small></a></li></ul></nav>",
      "css": ".ds-keys{display:flex;margin:0;padding:0;list-style:none;font-family:'Zen Maru Gothic',sans-serif;} .ds-keys li{position:relative;margin-left:-2px;} .ds-keys li:first-child{margin-left:0;} .ds-key{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;width:102px;height:74px;padding-bottom:8px;border:2px solid var(--color-ink,#2b1d1f);border-top:0;border-radius:0 0 12px 12px;background:var(--color-paper-light,#fdeee1);color:var(--color-ink,#2b1d1f);line-height:1.25;text-decoration:none;box-shadow:0 3px 0 0 var(--color-ink,#2b1d1f);transition:translate 100ms,box-shadow 100ms,background-color 100ms;} .ds-key b{font-size:15px;font-weight:900;} .ds-key small{font-size:12px;font-weight:700;} .ds-key[aria-current]{background:var(--color-yellow,#fbd96e);} .ds-key:hover,.ds-key:focus-visible{translate:0 3px;box-shadow:none;} .ds-key:focus-visible{outline:3px solid var(--color-ink,#2b1d1f);outline-offset:2px;} .ds-black{position:absolute;top:0;right:-9px;z-index:1;width:16px;height:38px;border-radius:0 0 6px 6px;background:var(--color-ink,#2b1d1f);pointer-events:none;}"
